<!-- views/user/dashboard.eta -->

<!-- ১. Eta কে বলছি যে এই পেইজটি কোন মাস্টার লেআউটটি ব্যবহার করবে -->
<% layout('../layouts/main') %>

<div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
    <h2 class="text-2xl font-semibold text-gray-800 mb-6">Users Directory</h2>

    <div class="grid gap-4">
        <!-- ২. Eta এর Loop (জাভাস্ক্রিপ্টের map বা forEach এর মতো) -->
    <!-- views/user/dashboard.eta এর ভেতরের লুপ আপডেট -->
        <% it.users.forEach(function(user) { %>
            <div class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-indigo-50 transition-colors border border-gray-200">
                
                <!-- নতুন Avatar UI (Utils থেকে পাওয়া Initials) -->
                <div class="flex-shrink-0 h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold mr-4">
                    <%= user.initials %>
                </div>
                
                <div class="flex-1">
                    <h3 class="font-medium text-gray-900"><%= user.name %></h3>
                    <p class="text-sm text-gray-500"><%= user.email %></p>
                </div>
                <span class="px-3 py-1 text-xs font-semibold text-indigo-700 bg-indigo-100 rounded-full">
                    Active
                </span>
            </div>
        <% }) %>
    </div>
</div>