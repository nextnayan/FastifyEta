<!-- views/error.eta -->
<% layout('./layouts/main') %>

<div class="max-w-xl mx-auto text-center bg-white p-10 rounded-2xl shadow-sm border border-gray-100 mt-16">
    <!-- স্ট্যাটাস কোড ডাইনামিক হবে (যেমন: 404, 500, 401) -->
    <h1 class="text-7xl font-extrabold text-red-500 mb-4 tracking-tight">
        <%= it.statusCode || 500 %>
    </h1>
    
    <h2 class="text-2xl font-bold text-gray-800 mb-3">Oops! Something went wrong.</h2>
    
    <!-- এরর মেসেজ -->
    <p class="text-gray-500 mb-8 text-lg">
        <%= it.message || 'We experienced an internal server error.' %>
    </p>
    
    <div class="flex justify-center space-x-4">
        <button onclick="window.history.back()" class="px-6 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors">
            Go Back
        </button>
        <a href="/api/users/dashboard" class="px-6 py-2 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-md shadow-indigo-200">
            Go to Dashboard
        </a>
    </div>
</div>